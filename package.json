{
  "name": "ng-pdf-annotator-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build:lib",
    "build:lib": "node scripts/copy-docs.mjs && ng build ng-pdf-annotator",
    "build:demo": "ng build demo",
    "watch": "ng build ng-pdf-annotator --watch --configuration development",
    "test": "ng test ng-pdf-annotator --watch=false",
    "pack:lib": "npm run build:lib && cd dist/ng-pdf-annotator && npm pack",
    "version:lib": "cd projects/ng-pdf-annotator && npm version --no-git-tag-version",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
